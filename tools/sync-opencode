#!/usr/bin/env python3
"""Links the library into OpenCode (Python 3 standard library only; Linux, macOS, and Windows with Developer Mode on).

    python3 tools/sync-opencode              link the skills and roles, and add the rule files to opencode.json
    python3 tools/sync-opencode --check      exit 1 unless all of that is in place and OpenCode itself lists
                                             every role and skill (asked through the `opencode` CLI when on PATH)
    python3 tools/sync-opencode --uninstall  remove this library's links and its opencode.json entries

What it touches, in OpenCode's config folder ($XDG_CONFIG_HOME/opencode, else ~/.config/opencode):
- skills/<name>: one link per skill. OpenCode also reads ~/.claude/skills (tools/sync-claude); a skill found in both
  is listed once (checked on 2.2.7).
- agents/<role>.md: one link per role in local-agents/opencode/agents/, generated by tools/gen_local_agents.py in
  OpenCode's own format (it skips a Claude Code agent file, warning only in its log).
- opencode.json `instructions`: adds local-agents/opencode/AGENTS.md (the rule sheet and skill index after a note on
  Claude Code-only features) and, if it exists, ~/.claude/CLAUDE.md (this machine's own rules). OpenCode 2.2.7 reads
  neither by itself: it doesn't fall back to ~/.claude/CLAUDE.md, or follow its `@` import (checked 2026-11-13, D35).
  The file's other keys are kept; a file with comments is left alone and the lines to add printed.
Then it reloads OpenCode's background service, so the next session sees the change.
A link or file it didn't make is left alone and reported. Re-run after a pull that adds or removes a skill or role;
a pull that only changes them needs nothing, since the links point into the clone.
"""
import argparse, json, os, pathlib, shutil, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
RULES = ROOT / "local-agents" / "opencode" / "AGENTS.md"


def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or str(pathlib.Path.home() / ".config")
    return pathlib.Path(base) / "opencode"


def entries():
    """The instructions entries, forward slashes on Windows too (as OpenCode's own paths look in JSON)."""
    own = pathlib.Path.home() / ".claude" / "CLAUDE.md"
    return [RULES.as_posix()] + ([own.as_posix()] if own.is_file() else [])


def ours_entry(x):
    """An entry an install of this script wrote, from this clone or another: dropped when it isn't wanted now."""
    return x.endswith("/local-agents/opencode/AGENTS.md") or x == (pathlib.Path.home() / ".claude" / "CLAUDE.md").as_posix()


def wanted():
    """(link, source) pairs: every skill folder and generated role."""
    cfg = config_dir()
    pairs = [(cfg / "skills" / d.name, d) for d in sorted((ROOT / "skills").iterdir()) if (d / "SKILL.md").is_file()]
    pairs += [(cfg / "agents" / f.name, f) for f in sorted((ROOT / "local-agents" / "opencode" / "agents").glob("*.md"))]
    return pairs


def target(p):
    """Where the link p points, as an absolute path, or None if p isn't a link."""
    if not p.is_symlink():
        return None
    t = os.readlink(p)
    t = t[4:] if t.startswith("\\\\?\\") else t  # Windows' long-path prefix
    return (p.parent / t).resolve() if not os.path.isabs(t) else pathlib.Path(t).resolve()


def ours(p):
    t = target(p)
    return t is not None and (t == ROOT or ROOT in t.parents)


def read_config(path):
    """(data, problem): the parsed opencode.json, or None and why it can't be edited."""
    if not path.exists():
        return {}, None
    try:
        data = json.loads(path.read_text(encoding="utf-8-sig") or "{}")
    except json.JSONDecodeError as e:
        return None, f"{path} isn't plain JSON ({e}), so it was left alone: its \"instructions\" list should be {entries()}"
    if not isinstance(data, dict) or not isinstance(data.get("instructions", []), list):
        return None, f"{path}: no \"instructions\" list, so it was left alone: it should list {entries()}"
    return data, None


def set_instructions(path, data, new):
    if new == data.get("instructions", []):
        return
    if new:
        data["instructions"] = new
    else:
        data.pop("instructions", None)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".sync-opencode.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)
    print(f"{path}: instructions now {new}")


def reload():
    if shutil.which("opencode"):
        subprocess.run([shutil.which("opencode"), "reload"], capture_output=True, timeout=60)


def sync():
    cfg, problems = config_dir(), []
    want = wanted()
    for link, source in want:
        if ours(link) and target(link) == source.resolve():
            continue
        if (link.exists() or link.is_symlink()) and not ours(link):
            problems.append(f"{link} isn't this library's link, so it was left alone (move it and re-run)")
            continue
        link.parent.mkdir(parents=True, exist_ok=True)
        if link.is_symlink():
            link.unlink()
        try:
            os.symlink(source, link, target_is_directory=source.is_dir())
        except OSError as e:
            problems.append(f"{link}: couldn't link ({e}); on Windows, turn on Developer Mode (README, \"Run it\")")
            continue
        print(f"linked {link}")
    keep = {link for link, _ in want}
    for d in (cfg / "skills", cfg / "agents"):
        for p in sorted(d.iterdir()) if d.is_dir() else []:
            if p not in keep and ours(p):  # a skill or role the library no longer has
                p.unlink()
                print(f"removed {p}")
    path = cfg / "opencode.json"
    data, problem = read_config(path)
    if problem:
        problems.append(problem)
    else:
        have = data.get("instructions", [])
        set_instructions(path, data, [x for x in have if not ours_entry(x) or x in entries()]
                         + [x for x in entries() if x not in have])
    reload()
    return problems


def ask_opencode(*args):
    """The JSON an `opencode` subcommand prints, or (None, why not)."""
    try:
        done = subprocess.run([shutil.which("opencode"), *args], capture_output=True, text=True, timeout=60)
        return json.loads(done.stdout), None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as e:
        return None, f"`opencode {' '.join(args)}` gave no JSON ({e})"


def check():
    problems = []
    want = wanted()
    for link, source in want:
        if target(link) != source.resolve():
            problems.append(f"{link}: not a link to {source} (run tools/sync-opencode)")
    path = config_dir() / "opencode.json"
    data, problem = read_config(path)
    if problem:
        problems.append(problem)
    else:
        problems += [f"{path}: instructions don't include {x}" for x in entries() if x not in data.get("instructions", [])]
    if not shutil.which("opencode"):
        print("opencode isn't on PATH: checked the files only, not what OpenCode loads")
        return problems
    # Ask OpenCode itself: it skips a role it can't parse, and drops a bad field of one it can, with only a log line.
    reload()
    roles = {link.stem for link, src in want if src.suffix == ".md"}
    skills = {link.name for link, src in want if src.is_dir()}
    agents, why = ask_opencode("debug", "agents")
    if why:
        problems.append(why)
    else:
        listed = {a["id"]: a for a in agents}
        for r in sorted(roles):
            a = listed.get(r)
            if a is None:
                problems.append(f"OpenCode doesn't list role {r} (its log says why: opencode debug paths, `log`)")
            # The deny-all shows the role's permissions arrived; the colour, that its frontmatter values were accepted.
            elif {"action": "*", "resource": "*", "effect": "deny"} not in a.get("permissions", []) or not a.get("color"):
                problems.append(f"OpenCode lists role {r} without its permissions or colour (its log says which field)")
    found, why = ask_opencode("api", "skill.list")
    if why:
        problems.append(why)
    else:
        problems += [f"OpenCode doesn't list skill {s}" for s in sorted(skills - {x["id"] for x in found["data"]})]
    if not problems:
        print(f"OpenCode lists all {len(roles)} roles and {len(skills)} skills")
    return problems


def uninstall():
    cfg = config_dir()
    for d in (cfg / "skills", cfg / "agents"):
        for p in sorted(d.iterdir()) if d.is_dir() else []:
            if ours(p):
                p.unlink()
                print(f"removed {p}")
    path = cfg / "opencode.json"
    data, problem = read_config(path)
    if not problem:
        set_instructions(path, data, [x for x in data.get("instructions", []) if not ours_entry(x)])
    reload()
    return [f"{path} was left alone: remove {entries()} from its instructions by hand"] if problem else []


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--uninstall", action="store_true")
    args = ap.parse_args()
    problems = check() if args.check else uninstall() if args.uninstall else sync()
    for p in problems:
        print(p)
    if args.check:
        print("opencode: " + ("OK" if not problems else f"{len(problems)} problem(s)"))
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()
